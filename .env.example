# 只有下面的账号密码是必填的。其余全部可以留空 —— 服务照常启动,
# 登录后在网页「系统设置」里配置。除 api_id/api_hash 外，保存即生效。
#
# 后台改过的项存进数据库,优先级高于本文件;之后再改这里不会生效,
# 除非在后台点该项的「恢复」。

# ===== 必填 =====

# Web 登录与 WebDAV(Basic)的账号密码
TGDRIVE_USERNAME=admin
TGDRIVE_PASSWORD=change-me

# ===== 可选:Compose 运行身份 =====

# tgdrive 进程的 UID/GID,需对宿主机 ./data 目录有写权限。
# 默认 1000:1000;宿主机用户不同时,分别填写 `id -u` 与 `id -g` 的输出。
#TGDRIVE_UID=1000
#TGDRIVE_GID=1000
# telegram-bot-api 镜像的数据文件组 ID,默认镜像为 101。
#TGDRIVE_BOT_API_GID=101

# ===== 可选:留空就在网页里配 =====

# Bot token,找 @BotFather 创建机器人获得
#TGDRIVE_BOT_TOKEN=123456:ABC-xxxxxxxx

# 存储目标:建议专用「私有频道」,把 bot 拉进频道并设为管理员
# 频道 ID 形如 -1001234567890(可把频道消息转发给 @userinfobot 等工具查看)
#TGDRIVE_CHAT_ID=-1001234567890

# Bot API 端点。默认官方;用自建服务器时改为下面的地址,并通过
# `docker compose --profile local-bot-api up -d` 启动对应 profile:
# TGDRIVE_API_BASE=http://telegram-bot-api:8081
#TGDRIVE_API_BASE=https://api.telegram.org

# 分块大小。默认:官方端点 18MB(官方 getFile 下载上限 20MB,不能配更大);
# 自建端点默认 1900MB(即上限,2000MB 留 100MB 余量)。支持 18MB / 512m / 1g 等写法
#TGDRIVE_CHUNK_SIZE=

# 分块并发上传数(默认 2;调大易触发 Telegram 限流 429)
#TGDRIVE_UPLOAD_CONCURRENCY=2

# 大分块暂存目录
#TGDRIVE_TMP_DIR=/tmp

# ===== 以下几项只能在这里配(改完要重启容器) =====

# 监听地址(容器内);SQLite 路径
#TGDRIVE_LISTEN=0.0.0.0:8080
#TGDRIVE_DB_PATH=/data/tgdrive.db

# 自建 Bot API --local 返回的绝对路径只允许从该目录读取。
# 需要与 compose 中共享卷的容器内路径一致。
#TGDRIVE_LOCAL_DATA_ROOT=/var/lib/telegram-bot-api

# cookie 签名密钥;不配则首次启动自动生成并存库。
# 仅首次启动时作为初始值,之后以库中的值为准(后台「登出所有会话」会轮换它)
#TGDRIVE_SECRET=

# 通过 HTTPS（含反向代理）访问时设为 true，为 Cookie 加 Secure 并启用 HSTS。
#TGDRIVE_COOKIE_SECURE=false

# 日志级别
#RUST_LOG=info

# ===== MTProto 流式播放 / 自建 Bot API 共同使用 =====
# 在 https://my.telegram.org 申请。tgdrive 用它们绕过会先整块下载的 Bot API
# getFile，以 512KiB 请求响应浏览器 Range；不改变现有 Telegram 分块大小。
# telegram-bot-api 容器也读取这两项。修改后需要重启/重建两个服务：
#   docker compose --profile local-bot-api up -d --build tgdrive telegram-bot-api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
