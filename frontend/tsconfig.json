{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@apps/*": ["../apps/frontend/*"],
      "@drive/*": ["./src/*"],
      "vue": ["./node_modules/vue"],
      "vue-router": ["./node_modules/vue-router"],
      "element-plus": ["./node_modules/element-plus"],
      "@element-plus/icons-vue": ["./node_modules/@element-plus/icons-vue"],
      "vitest": ["./node_modules/vitest"],
      "mediabunny": ["./node_modules/mediabunny/dist/mediabunny.d.ts"],
      "pdfjs-dist": ["./node_modules/pdfjs-dist/types/src/pdf.d.ts"],
      "pdfjs-dist/*": ["./node_modules/pdfjs-dist/*"],
      "dompurify": ["./node_modules/dompurify"],
      "@zip.js/zip.js/*": ["./node_modules/@zip.js/zip.js/index.d.ts"]
    },
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../apps/frontend/**/*.ts", "../apps/frontend/**/*.vue", "../apps/reader/**/*.ts", "../apps/books/**/*.ts", "../apps/comics/**/*.ts", "../apps/cinema/**/*.ts", "../apps/sdk/types.ts"]
}
