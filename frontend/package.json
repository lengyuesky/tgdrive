{
  "name": "tgdrive-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p playwright.apps.tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:apps": "playwright test --config playwright.apps.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tanstack/vue-virtual": "^3.13.26",
    "axios": "^1.13.0",
    "element-plus": "^2.13.0",
    "hash-wasm": "^4.12.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.6",
    "vue-tsc": "^3.3.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
